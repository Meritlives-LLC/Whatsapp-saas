# ─────────────────────────────────────────────────────────────────────────────
# WA AutoBot — Backend Environment Variables
# Copy this file to .env and fill in your real values.
#
#   cp .env.example .env
#
# This file is safe to commit — it contains placeholders only, never real
# secrets. Never put a real value from here into git.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=5000

# ── URLs ───────────────────────────────────────────────────────────────────────
# Your deployed backend URL (no trailing slash) — used to build the Meta OAuth
# redirect_uri and other absolute links.
BACKEND_URL=http://localhost:5000
# Your deployed frontend URL (no trailing slash) — also the primary trusted
# CORS origin. See ADDITIONAL_ALLOWED_ORIGINS below for extra origins.
FRONTEND_URL=http://localhost:5173

# ── CORS ───────────────────────────────────────────────────────────────────────
# Optional, comma-separated list of EXTRA origins to trust in production,
# beyond FRONTEND_URL (e.g. a specific staging URL). Arbitrary *.vercel.app
# preview deployments are only auto-trusted when NODE_ENV is NOT "production" —
# in production, every trusted origin must be listed explicitly here.
# ADDITIONAL_ALLOWED_ORIGINS=https://staging.example.com,https://admin.example.com

# ── MongoDB ──────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/wa-autobot

# ── Auth ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret
JWT_EXPIRES_IN=7d

# 32-byte key (64 hex chars) used to encrypt sensitive fields (WhatsApp access
# tokens, registration PINs) at rest. REQUIRED — the server validates this at
# boot and refuses to start with a missing/malformed key.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=replace_with_a_64_character_hex_string

# ── Meta / WhatsApp ────────────────────────────────────────────────────────────
# From https://developers.facebook.com → Your App → Settings → Basic
META_APP_ID=your_meta_app_id
# Backend-only — never expose this to the frontend/browser.
META_APP_SECRET=your_meta_app_secret
# From https://developers.facebook.com → Your App → WhatsApp → Embedded Signup
# → Configuration ID. Must match VITE_META_CONFIG_ID in the frontend .env.
META_CONFIG_ID=your_meta_embedded_signup_config_id
# Optional — Graph API version override. Defaults to config/meta.js's built-in
# value if unset.
# META_GRAPH_API_VERSION=v23.0
# Verify token your webhook endpoint expects Meta to echo back during the
# GET /api/webhook handshake.
WHATSAPP_VERIFY_TOKEN=choose_a_verify_token

# ── Google OAuth (login) ───────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# ── Email (transactional) ──────────────────────────────────────────────────────
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASS=your_smtp_password
EMAIL_FROM="WA AutoBot <no-reply@example.com>"

# ── Payments (Paystack) ────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=your_paystack_secret_key
PAYSTACK_PLAN_STARTER=your_paystack_plan_code
PAYSTACK_PLAN_GROWTH=your_paystack_plan_code
PAYSTACK_PLAN_PRO=your_paystack_plan_code
DEFAULT_CURRENCY=NGN

# ── AI ─────────────────────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=your_deepseek_api_key

# ── Admin seed script (scripts/seedAdmin.js) ───────────────────────────────────
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose_a_strong_password
