# ─────────────────────────────────────────────────────────────────────────────
# WA AutoBot — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
#
#   cp .env.example .env.local
#
# Vite only exposes variables that start with VITE_ to the browser.
# Never put secrets here — this runs in the browser.
# ─────────────────────────────────────────────────────────────────────────────


# ── Backend API URL ───────────────────────────────────────────────────────────
# Development: leave blank — Vite proxies /api → http://localhost:5000 automatically.
# Production: set to your deployed backend URL (no trailing slash).
#
# VITE_API_URL=https://yourapi.onrender.com/api


# ── Meta App ID ───────────────────────────────────────────────────────────────
# Your Meta App ID — same value as META_APP_ID in the backend .env.
# This is public (visible in browser) — it's safe to put here.
# When set, the "Connect with Facebook" button is shown on the WhatsApp setup page.
# If blank, the page still works but users won't see the one-click OAuth button.
#
# Get it from: https://developers.facebook.com → Your App → Settings → Basic
VITE_META_APP_ID=your_meta_app_id
